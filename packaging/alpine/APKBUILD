# Maintainer: AkumaNomu <akumanomu@proton.me>
pkgname=memreduct
pkgver=0.2.0
pkgrel=0
pkgdesc="Monitor and reclaim Linux memory caches (Mem Reduct port)"
url="https://github.com/AkumaNomu/MemReRust"
arch="all"
license="GPL-3.0-only"
makedepends="cargo"
source="$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
options="!check"  # unit tests run in CI; keep abuild fast

prepare() {
	default_prepare
	cargo fetch --locked --offline
}

build() {
	cargo build --frozen --release --offline
}

package() {
	install -Dm0755 target/release/memreduct -t "$pkgdir"/usr/bin/
	install -Dm0644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md

	./target/release/memreduct completions bash \
		| install -Dm0644 /dev/stdin "$pkgdir"/usr/share/bash-completion/completions/$pkgname
	./target/release/memreduct completions zsh \
		| install -Dm0644 /dev/stdin "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
	./target/release/memreduct completions fish \
		| install -Dm0644 /dev/stdin "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
}
